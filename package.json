{
  "name": "agentproxy-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "setup": "pnpm build && node packages/server/dist/index.js setup",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "pnpm build && pnpm --filter @agentproxy/e2e test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
