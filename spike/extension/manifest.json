{
  "manifest_version": 3,
  "name": "API Mock Spike",
  "version": "0.0.3",
  "description": "Spike: applies mock rules pushed from a local server.",
  "background": { "service_worker": "sw.js", "type": "module" },
  "permissions": ["declarativeNetRequest", "alarms", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost/*"],
      "js": ["mock-wrapper.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["http://localhost/*"],
      "js": ["relay.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
